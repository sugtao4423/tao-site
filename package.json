{
  "name": "tao-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next && next dev",
    "build": "rm -rf .next && next build",
    "build:standalone": "rm -rf .next && next build && cd .next/standalone/ && ln -s ../../public . && cd .next/ && ln -s ../../static .",
    "zip:standalone": "cd .next/standalone/ && zip -rq ../../tao-site.zip .",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint --max-warnings=0 .",
    "lint:inspect": "eslint --inspect-config",
    "stylelint": "stylelint '{**/*,*}.{css,scss}'",
    "stylelint:fix": "stylelint --fix '{**/*,*}.{css,scss}'",
    "prettier": "prettier --check '{**/*,*}.{js,jsx,mjs,ts,tsx,css,scss,json}'",
    "prettier:fix": "prettier --write '{**/*,*}.{js,jsx,mjs,ts,tsx,css,scss,json}'"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bootstrap": "5.3.8",
    "clsx": "^2.1.1",
    "next": "16.3.5",
    "nuqs": "^2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.6",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": "^24"
  }
}
